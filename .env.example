# ── 数据库 ─────────────────────────────────────────────
# Vercel Postgres 连接串：Vercel 控制台 → 项目 → Storage → 创建 Postgres → 复制连接串
# 用法：复制本文件为 .env.local 并填入真实值（.env.local 已被 git 忽略）
DATABASE_URL=

# ── 认证（Auth.js）────────────────────────────────────
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true

# GitHub OAuth App：https://github.com/settings/developers → New OAuth App
# Callback URL 本地：http://localhost:3000/api/auth/callback/github
# Callback URL 线上：https://<你的域名>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
